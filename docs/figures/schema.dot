// Generated by make_schema.py. DocPilot relational schema; vector columns and indexes omitted.
digraph schema {
graph [rankdir=LR, fontname="Nimbus Sans", fontsize=11, nodesep=0.45, ranksep=0.75,
       pad=0.1, newrank=true, splines=spline];
node  [shape=plaintext, fontname="Nimbus Sans", fontsize=10, margin=0];
edge  [fontname="Nimbus Sans", fontsize=8.5, color="#3C3C3C", penwidth=0.9, arrowsize=0.75, dir=both];

subgraph cluster_conv {
  label=<<B>Conversation log</B>>; labeljust=l; fontcolor="#7A4B1C";
  style="rounded,dashed"; color="#C9A27A"; penwidth=0.9; margin=14;
  conversations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2.5" COLOR="#7A4B1C">
    <TR><TD COLSPAN="4" BGCOLOR="#F4E6D6" ALIGN="LEFT" CELLPADDING="5"><B>conversations</B></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id_w"><FONT POINT-SIZE="8" COLOR="#7A4B1C"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id_e"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">text</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">timestamptz</FONT></TD><TD WIDTH="4"></TD></TR>
  </TABLE>>];
  messages [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2.5" COLOR="#7A4B1C">
    <TR><TD COLSPAN="4" BGCOLOR="#F4E6D6" ALIGN="LEFT" CELLPADDING="5"><B>messages</B></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id_w"><FONT POINT-SIZE="8" COLOR="#7A4B1C"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id_e"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">uuid</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="conversation_id_w"><FONT POINT-SIZE="8" COLOR="#7A4B1C"><B>FK</B></FONT></TD><TD ALIGN="LEFT">conversation_id</TD><TD ALIGN="LEFT" PORT="conversation_id_e"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">text</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">{user, assistant}</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">text</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">timestamptz</FONT></TD><TD WIDTH="4"></TD></TR>
  </TABLE>>];
  traces [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2.5" COLOR="#7A4B1C">
    <TR><TD COLSPAN="4" BGCOLOR="#F4E6D6" ALIGN="LEFT" CELLPADDING="5"><B>traces</B></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#7A4B1C"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">bigint</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="message_id_w"><FONT POINT-SIZE="8" COLOR="#7A4B1C"><B>FK, UQ</B></FONT></TD><TD ALIGN="LEFT">message_id</TD><TD ALIGN="LEFT" PORT="message_id_e"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">uuid</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="retrieved_w"></TD><TD ALIGN="LEFT"><I>retrieved_chunk_ids</I></TD><TD ALIGN="LEFT" PORT="retrieved_e"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">bigint[]</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"><I>rejected_citation_ids</I></TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">bigint[]</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tool_calls</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">jsonb</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">model</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">text</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">input_tokens</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">int</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">output_tokens</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">int</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">latency_ms</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">int</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cost_usd</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">numeric</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">timestamptz</FONT></TD><TD WIDTH="4"></TD></TR>
  </TABLE>>];
}

subgraph cluster_docs {
  label=<<B>Document store</B>>; labeljust=l; fontcolor="#1F4E79";
  style="rounded,dashed"; color="#8EA9C8"; penwidth=0.9; margin=14;
  documents [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2.5" COLOR="#1F4E79">
    <TR><TD COLSPAN="4" BGCOLOR="#DCE6F2" ALIGN="LEFT" CELLPADDING="5"><B>documents</B></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id_w"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id_e"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">bigint</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">text</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">text</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">{upload, generated}</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">timestamptz</FONT></TD><TD WIDTH="4"></TD></TR>
  </TABLE>>];
  chunks [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2.5" COLOR="#1F4E79">
    <TR><TD COLSPAN="4" BGCOLOR="#DCE6F2" ALIGN="LEFT" CELLPADDING="5"><B>chunks</B></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="id_w"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id_e"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">bigint</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="document_id_w"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>FK</B></FONT></TD><TD ALIGN="LEFT">document_id</TD><TD ALIGN="LEFT" PORT="document_id_e"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">bigint</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ord</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">int</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT FACE="Source Code Pro" POINT-SIZE="8.5" COLOR="#6B6B6B">text</FONT></TD><TD WIDTH="4"></TD></TR>
    <TR><TD></TD><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#8A8A8A"><I>UNIQUE (document_id, ord)</I></FONT></TD></TR>
  </TABLE>>];
}


legend [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
  <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#3C3C3C"><B>Edges</B>&#160;(crow&#39;s-foot cardinality)</FONT></TD></TR>
  <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#3C3C3C">solid: foreign key, ON DELETE CASCADE</FONT></TD></TR>
  <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#3C3C3C">dashed: id array, no foreign key</FONT></TD></TR>
  <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#3C3C3C"><I>italic</I>&#160;columns hold such arrays</FONT></TD></TR>
</TABLE>>];
{rank=same; conversations; legend}
{rank=same; messages; documents}
{rank=same; traces; chunks}

// Crow's foot: tee = one, crow = many, odot = optional.
conversations:id_e:e -> messages:conversation_id_w:w [arrowtail=teetee, arrowhead=crowodot];
messages:id_e:e      -> traces:message_id_w:w        [arrowtail=teetee, arrowhead=teeodot];
documents:id_e:e     -> chunks:document_id_w:w       [arrowtail=teetee, arrowhead=crowodot];

// Soft reference: an array of ids, not enforced by a foreign key.
traces:retrieved_e:e -> chunks:id_e:e [dir=forward, style=dashed, color="#8A8A8A", arrowhead=vee,
    arrowsize=0.6, constraint=false];
}
