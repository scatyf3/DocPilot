# Copy to .env and fill in. Every variable is optional except the keys for the providers you pick.

# --- Security and limits ---------------------------------------------------
# development | production. Production refuses to start without API_KEYS.
ENVIRONMENT=development
# Comma-separated shared keys, sent as `Authorization: Bearer <key>`. Empty disables auth.
API_KEYS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=10
# Header holding the real client IP. Only set it (to x-client-ip) when the API requires a key and
# the web app runs with TRUST_FORWARDED_FOR=true; anyone reaching the API directly can forge it.
CLIENT_IP_HEADER=
MAX_QUESTION_CHARS=8000
MAX_HISTORY_MESSAGES=40
CHAT_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
EMBEDDING_TIMEOUT_SECONDS=30
LOG_JSON=false
LOG_LEVEL=INFO

# --- Storage --------------------------------------------------------------
# Postgres with the pgvector extension (docker compose, Supabase or Neon).
DATABASE_URL=postgresql://docpilot:docpilot@localhost:5432/docpilot
# Schema (namespace) for DocPilot's tables. Evals use their own: docpilot_eval.
DB_SCHEMA=public
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# --- Chat model -----------------------------------------------------------
# anthropic | openai | fake   (fake = scripted offline model for tests and demos)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (adaptive thinking depth)
ANTHROPIC_EFFORT=medium
MAX_OUTPUT_TOKENS=16000
# Upper bound on model turns (tool round-trips) per question.
MAX_AGENT_STEPS=6

# --- OpenAI-compatible endpoint (OpenAI, or the LLM Gateway) ---------------
# Used for embeddings when EMBEDDING_PROVIDER=openai, and for chat when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Leave empty for api.openai.com; set to e.g. http://localhost:8080/v1 for the LLM Gateway.
OPENAI_BASE_URL=
# Chat model name when LLM_PROVIDER=openai (whatever the gateway routes).
CHAT_MODEL=gpt-4.1-mini

# --- Embeddings -----------------------------------------------------------
# openai | fake   (fake = deterministic hashed bag-of-words, no key needed)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must stay 1024: it is fixed by the vector(1024) column.
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=64

# --- Chunking -------------------------------------------------------------
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=60

# --- Retrieval ------------------------------------------------------------
# vector | fts | hybrid   (default for chat; /search and evals can override per request)
RETRIEVAL_MODE=hybrid
# none | cohere   (second-stage reranker)
RERANKER=none
RERANK_API_KEY=
RERANK_MODEL=rerank-v3.5
# Candidates each retriever contributes before fusion/reranking.
CANDIDATE_K=30

# --- Web ------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Server-side settings of the web app, which proxies browser calls to the API.
API_URL=http://localhost:8000
# One of API_KEYS, sent by the proxy. The browser never sees it.
API_KEY=
# true only behind a platform that overwrites x-forwarded-for, such as Vercel. Otherwise every
# visitor shares one rate-limit bucket.
TRUST_FORWARDED_FOR=false
# Basic Auth password for the whole site (any username). Empty leaves the site open.
WEB_PASSWORD=

# --- Evals ----------------------------------------------------------------
JUDGE_MODEL=claude-opus-5-5
JUDGE_EFFORT=low
