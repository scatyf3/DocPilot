# Copy to .env and fill in. Every variable is optional except the keys for the providers you pick.

# --- Security and limits ---------------------------------------------------
# development | production. Production refuses to start without API_KEYS or JWT_SECRETS.
ENVIRONMENT=development
# Comma-separated service keys, sent as `Authorization: Bearer <key>` or `X-API-Key`. A key acts
# on the default tenant (1). With no keys and no token, development lets anyone in as tenant 1.
API_KEYS=
# User accounts (POST /auth/register, /auth/login). Comma-separated HS256 secrets: the first
# signs, all verify, so add a new one in front, deploy, then drop the old one after
# ACCESS_TOKEN_TTL_SECONDS. At least 32 characters each in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ALLOW_SIGNUP=true
# argon2id cost. Each hash holds ARGON2_MEMORY_KIB of RAM; at most PASSWORD_HASH_CONCURRENCY run
# at once per instance.
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
PASSWORD_HASH_CONCURRENCY=4
RATE_LIMIT_ENABLED=true
# Per user (by token) or per client IP (API keys, anonymous). Shared by all instances with Redis.
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=10
# Login, sign-up and refresh: per IP, and per email for login.
RATE_LIMIT_AUTH_PER_MINUTE=10
# Header holding the real client IP. Only set it (to x-client-ip) when the API requires a key and
# the web app runs with TRUST_FORWARDED_FOR=true; anyone reaching the API directly can forge it.
CLIENT_IP_HEADER=
MAX_QUESTION_CHARS=8000
MAX_HISTORY_MESSAGES=40
CHAT_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
EMBEDDING_TIMEOUT_SECONDS=30
LOG_JSON=false
LOG_LEVEL=INFO

# --- Storage --------------------------------------------------------------
# Postgres with the pgvector extension (docker compose, Supabase or Neon).
DATABASE_URL=postgresql://docpilot:docpilot@localhost:5432/docpilot
# Schema (namespace) for DocPilot's tables. Evals use their own: docpilot_eval.
DB_SCHEMA=public
# Role the app's connections switch to, so Postgres row-level security applies to them.
# `docpilot db init` creates it (needs CREATEROLE). Empty: tenant filters in queries only.
DB_APP_ROLE=docpilot_app
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# --- Redis ----------------------------------------------------------------
# Shared rate limits, retrieval caches and the ingest queue. Empty: per-instance limits, no cache.
REDIS_URL=
REDIS_TIMEOUT_SECONDS=0.5
# Cached search results are dropped on any write to the tenant's library; 0 disables a cache.
SEARCH_CACHE_TTL_SECONDS=300
QUERY_EMBEDDING_CACHE_TTL_SECONDS=86400

# --- Ingest ---------------------------------------------------------------
# inline: index inside the upload request. queue: return 202 + job id, `docpilot worker` indexes.
INGEST_MODE=inline
WORKER_CONCURRENCY=4
INGEST_JOB_TIMEOUT_SECONDS=900
INGEST_JOB_MAX_TRIES=3

# --- Chat model -----------------------------------------------------------
# anthropic | openai | fake   (fake = scripted offline model for tests and demos)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (adaptive thinking depth)
ANTHROPIC_EFFORT=medium
MAX_OUTPUT_TOKENS=16000
# Upper bound on model turns (tool round-trips) per question.
MAX_AGENT_STEPS=6

# --- OpenAI-compatible endpoint (OpenAI, or the LLM Gateway) ---------------
# Used for embeddings when EMBEDDING_PROVIDER=openai, and for chat when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Leave empty for api.openai.com; set to e.g. http://localhost:8080/v1 for the LLM Gateway.
OPENAI_BASE_URL=
# Chat model name when LLM_PROVIDER=openai (whatever the gateway routes).
CHAT_MODEL=gpt-4.1-mini

# --- Embeddings -----------------------------------------------------------
# openai | fake   (fake = deterministic hashed bag-of-words, no key needed)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Optional separate endpoint for embeddings (e.g. a local bge-m3 server when chat goes to an API
# without /embeddings, such as DeepSeek). Empty falls back to OPENAI_BASE_URL / OPENAI_API_KEY.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Must stay 1024: it is fixed by the vector(1024) column.
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=64

# --- Chunking -------------------------------------------------------------
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=60

# --- Retrieval ------------------------------------------------------------
# vector | fts | hybrid   (default for chat; /search and evals can override per request)
RETRIEVAL_MODE=hybrid
# none | cohere   (second-stage reranker)
RERANKER=none
RERANK_API_KEY=
RERANK_MODEL=rerank-v3.5
# Candidates each retriever contributes before fusion/reranking.
CANDIDATE_K=30

# --- Web ------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Server-side settings of the web app, which proxies browser calls to the API.
API_URL=http://localhost:8000
# One of API_KEYS, sent by the proxy. The browser never sees it.
API_KEY=
# true only behind a platform that overwrites x-forwarded-for, such as Vercel. Otherwise every
# visitor shares one rate-limit bucket.
TRUST_FORWARDED_FOR=false
# Basic Auth password for the whole site (any username). Empty leaves the site open.
WEB_PASSWORD=

# --- Evals ----------------------------------------------------------------
JUDGE_MODEL=claude-opus-5-5
JUDGE_EFFORT=low

# --- Production (docker-compose.prod.yml) ---------------------------------
# Hostname that points at the server. Without a domain, <ip-with-dashes>.sslip.io resolves to the
# IP, e.g. 203-0-113-7.sslip.io, and Caddy gets a certificate for it.
DOMAIN=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# (hex, so the password is safe inside DATABASE_URL)
POSTGRES_PASSWORD=
# Also required: API_KEY and WEB_PASSWORD in the Web block above. API_KEY becomes the API's only
# key (API_KEYS is ignored), and the site asks for WEB_PASSWORD.
